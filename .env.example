# ==============================================================================
# ZaaykaTech SaaS — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit your .env.local file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Row Level Security)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-or-secret-key"

# ------------------------------------------------------------------------------
# 2. Application Core & Lifecycle Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TRIAL_DURATION_HOURS="24"
GRACE_PERIOD_HOURS="24"

# ------------------------------------------------------------------------------
# 3. Razorpay (Yearly Subscription Billing - ₹2,999 / 365 Days)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ------------------------------------------------------------------------------
# 4. Cloudflare R2 (Hero Videos, Logos, Dish Photos, AI Document Vault)
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="zaaykatech-media"
CLOUDFLARE_R2_PUBLIC_URL="https://media.zaaykatech.com"

# ------------------------------------------------------------------------------
# 5. Google Gemini AI (Genkit Multi-Modal Menu Extraction)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key"
